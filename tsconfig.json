{
  // Browser code. TypeScript only *checks* types here (noEmit); Vite does the
  // actual TS -> JS conversion when serving and bundling.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",

    // TypeScript 7.0.2's built-in "dom" library has only part of the WebGPU
    // types, so we use @types/web instead of "dom", as the @webgpu/types
    // README recommends: https://github.com/gpuweb/types
    "lib": ["ESNext"],
    "types": ["@types/web"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // Only TypeScript syntax that can simply be deleted to get JavaScript
    // (no enums, namespaces, parameter properties). That lets Node run our
    // .ts tests directly: https://nodejs.org/api/typescript.html
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    // Don't type-check the .d.ts files of dependencies (@types/web and
    // @types/node both describe some of the same globals).
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
