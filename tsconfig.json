{
  // Browser code and tests need different types (web vs web + Node), so each
  // has its own config. Editors only look for files named tsconfig.json, so
  // this one lists no files itself and points them at the config for each
  // file instead: https://www.typescriptlang.org/docs/handbook/project-references.html
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }]
}
